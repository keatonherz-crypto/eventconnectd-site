# Reddit "script" app credentials -- create one at https://reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=painpoint-scanner/0.1 by u/yourusername

# Classification (Haiku) and digest synthesis
ANTHROPIC_API_KEY=

# Postgres in production; a local file is fine while you are still tuning:
#   DATABASE_URL=sqlite:///painpoints.db
DATABASE_URL=postgresql://user:pass@host:5432/painpoints

# Only needed when clusterer.embedding_backend is "openai"
OPENAI_API_KEY=
