# Pain point scanner schedule.
#
# Install with:  crontab deploy/crontab.example
# Adjust APP_DIR and PY to match the box. Cron runs with a minimal environment,
# so the absolute paths matter and .env is loaded by the app itself.

APP_DIR=/opt/painpoint-scanner
PY=/opt/painpoint-scanner/.venv/bin/python
MAILTO=""

# Collect every 6 hours. The sweep window overlaps the interval on purpose:
# duplicates are free (dedup on Reddit ID), gaps are not.
0 */6 * * * cd $APP_DIR && $PY -m painpoint collect >> logs/collect.log 2>&1

# Classify 20 minutes later, once the sweep has settled.
20 */6 * * * cd $APP_DIR && $PY -m painpoint classify >> logs/classify.log 2>&1

# Recluster and publish the digest on Monday mornings.
0 6 * * 1 cd $APP_DIR && $PY -m painpoint cluster >> logs/cluster.log 2>&1
30 6 * * 1 cd $APP_DIR && $PY -m painpoint report >> logs/report.log 2>&1
